{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "watchPatterns": ["server/src/**", "server/package*.json", "web/**", "deployments/**", "Dockerfile", "railway.json"]
  },
  "deploy": {
    "healthcheckPath": "/api/info",
    "restartPolicyType": "ON_FAILURE"
  }
}
